<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- 📍 Location Permissions -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>This app requires access to your location to determine Qibla direction and accurate prayer times.</string>
  <key>NSLocationAlwaysUsageDescription</key>
  <string>This app uses your location in the background for scheduled Azan notifications and accurate prayer times.</string>

  <!-- 🔔 Notification Permissions -->
  <key>NSUserNotificationAlertUsageDescription</key>
  <string>This app sends prayer time notifications and Islamic reminders throughout the day.</string>

  <!-- 🎤 Microphone (used for Azan playback and voice features) -->
  <key>NSMicrophoneUsageDescription</key>
  <string>This app needs microphone access for playing Azan and possible voice interaction features.</string>

  <!-- 📸 Camera (optional future features like scanning) -->
  <key>NSCameraUsageDescription</key>
  <string>This app may use your camera to scan QR codes or upload a profile photo.</string>

  <!-- 🖼️ Media/Photo/File Permissions -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>This app may access your photo library for uploading profile images or sharing Islamic content.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>This app saves and reads PDFs or audio files like Quran and Azan.</string>
  <key>NSFileProviderPresenceUsageDescription</key>
  <string>This app may access saved Islamic files and content like prayer books or recordings.</string>

  <!-- 🌐 Allow HTTP temporarily (disable in production) -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>

  <!-- ⏱️ Background Modes (Azan update / location) -->
  <key>UIBackgroundModes</key>
  <array>
    <string>location</string>
    <!-- Optional: <string>audio</string> if using persistent Azan playback -->
  </array>

  <key>UIBackgroundModes</key>
<array>
  <string>audio</string>
</array>
<key>NSUserNotificationAlertStyle</key>
<string>alert</string>

  <!-- 📦 App Metadata -->
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Islamic App</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>islamic_app</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(FLUTTER_BUILD_NAME)</string>
  <key>CFBundleVersion</key>
  <string>$(FLUTTER_BUILD_NUMBER)</string>

  <!-- 📱 Orientation Support -->
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- ⚙️ Performance Tweaks -->
  <key>CADisableMinimumFrameDurationOnPhone</key>
  <true/>
  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>

</dict>
</plist>
